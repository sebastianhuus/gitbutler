{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main",
	"description": "permissions for gitbutler tauri",
	"windows": ["*"],
	"local": true,
	"permissions": [
		"core:default",
		"core:event:default",
		"core:window:allow-start-dragging",
		"core:window:allow-set-title",
		"core:window:default",
		"dialog:allow-open",
		"dialog:allow-ask",
		"fs:allow-read-file",
		"fs:allow-cache-read-recursive",
		"log:default",
		"process:default",
		"shell:allow-open",
		"shell:allow-execute",
		"store:default",
		"updater:default",
		"http:allow-fetch",
		"clipboard-manager:allow-read-text",
		"clipboard-manager:allow-write-text",
		"deep-link:default",
		{
			"identifier": "http:default",
			"allow": [
				{
					"url": "http://127.0.0.1:*/**"
				},
				{
					"url": "http://localhost:*/**"
				}
			]
		},
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "open",
					"cmd": "open",
					"args": ["-a", "GitButler"]
				}
			]
		}
	]
}
